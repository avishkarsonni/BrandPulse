# BrandPulse Local Configuration
# This file contains configuration for running services locally without Docker

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=brandpulse_user
DB_PASSWORD=brandpulse_password
DB_NAME=brandpulse

# Service Ports
BACKEND_PORT=8000
DATABASE_API_PORT=8001
FRONTEND_PORT=3000
REDIS_PORT=6379

# API URLs (for frontend)
REACT_APP_API_URL=http://localhost:8000
REACT_APP_DB_API_URL=http://localhost:8001
REACT_APP_WS_URL=ws://localhost:8000

# Environment
NODE_ENV=development
LOG_LEVEL=info

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Google API (optional)
GOOGLE_API_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


















